# FoodieHut Environment Variables Example

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# MySQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=foodiehut
DATABASE_USERNAME=foodiehut
DATABASE_PASSWORD=foodiehut123
MYSQL_ROOT_PASSWORD=rootpassword123

# Security & JWT (Secret must be at least 256 bits)
JWT_SECRET=FoodieHutSecureJwtKeyMustBeAtLeast256BitsLongForHmacSha256Security123!
JWT_EXPIRATION_MS=86400000

# OTP Configuration
OTP_PROVIDER=mock
DEFAULT_MOCK_OTP=123456
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# SMTP / Email Provider (for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-canteen-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Frontend and CORS
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

